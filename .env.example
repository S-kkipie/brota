# Brota — environment variables. Copy to .env and fill. NEVER commit .env.

# --- Database (SQLite via libSQL + Drizzle) ---
# Local dev: a file. Production (Railway/Turso): a libSQL URL (libsql://...).
DATABASE_URL=file:./local.db

# --- Gemini (Google Gen AI) ---
GEMINI_API_KEY=

# --- Wallet encryption (custodial-with-limits) ---
# 32 bytes as 64 hex chars. Generate with: openssl rand -hex 32
WALLET_ENCRYPTION_KEY=

# --- Meta WhatsApp Cloud API ---
# Token + phone number id from the Meta app; verify token is your own secret
# string, echoed back during webhook subscription (GET hub.challenge).
# App secret signs inbound webhooks (X-Hub-Signature-256) — set it in prod or
# the endpoint runs unauthenticated.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Telegram Bot API ---
# Bot token from BotFather. Webhook secret is your own random string, set at
# registration and echoed back in X-Telegram-Bot-Api-Secret-Token — set it in
# prod or the endpoint runs unauthenticated. Register the webhook once:
#   curl "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/setWebhook" \
#     -d "url=https://<host>/api/telegram" \
#     -d "secret_token=${TELEGRAM_WEBHOOK_SECRET}"
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Stellar (testnet defaults; override only when going to mainnet) ---
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# --- DeFindex ---
# REST API key (free): register at https://api.defindex.io/register
# Without it, lib/defindex.ts runs in clearly-logged mock mode (no on-chain tx).
DEFINDEX_API_KEY=
# Published PaltaLabs USDC reference vault on TESTNET. Testnet resets can change
# this — re-check https://raw.githubusercontent.com/defindex-io/stellar-contracts/main/public/testnet.contracts.json
DEFINDEX_VAULT_ID=CBMVK2JK6NTOT2O4HNQAIQFJY232BHKGLIMXDVQVHIIZKDACXDFZDWHN
