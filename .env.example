# Brota — environment variables. Copy to .env and fill. NEVER commit .env.

# --- Database (SQLite via libSQL + Drizzle) ---
# Local dev: a file. Production (Railway/Turso): a libSQL URL (libsql://...).
DATABASE_URL=file:./local.db

# --- Gemini (Google Gen AI) ---
GEMINI_API_KEY=

# --- Wallet encryption (custodial-with-limits) ---
# 32 bytes as 64 hex chars. Generate with: openssl rand -hex 32
WALLET_ENCRYPTION_KEY=

# --- Meta WhatsApp Cloud API ---
# Token + phone number id from the Meta app; verify token is your own secret
# string, echoed back during webhook subscription (GET hub.challenge).
# App secret signs inbound webhooks (X-Hub-Signature-256) — set it in prod or
# the endpoint runs unauthenticated.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Stellar (testnet defaults; override only when going to mainnet) ---
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# --- DeFindex (set after verifying the testnet vault on Day 1) ---
DEFINDEX_VAULT_ID=
