# Brota — environment variables. Copy to .env and fill. NEVER commit .env.

# --- Database (Supabase / Postgres) ---
DATABASE_URL=postgres://user:pass@host:5432/brota

# --- Gemini (Google Gen AI) ---
GEMINI_API_KEY=

# --- Wallet encryption (custodial-with-limits) ---
# 32 bytes as 64 hex chars. Generate with: openssl rand -hex 32
WALLET_ENCRYPTION_KEY=

# --- Twilio WhatsApp ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Stellar (testnet defaults; override only when going to mainnet) ---
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# --- DeFindex (set after verifying the testnet vault on Day 1) ---
DEFINDEX_VAULT_ID=
